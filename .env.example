# Fill LINE, Discord, or both — results go to every channel that has values.

# LINE: developers.line.biz > channel > Messaging API tab > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# LINE: Basic settings tab > Your user ID
LINE_USER_ID=

# Discord: Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# optional — without it the catalyst comes from Yahoo news
BENZINGA_API_KEY=
